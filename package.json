{
  "name": "booptracker",
  "version": "0.0.1",
  "description": "BoopTracker — a family boop-scorekeeping app (Expo + Firebase). Not social media: open it, record a boop or check your score, leave.",
  "keywords": [
    "expo",
    "react-native",
    "firebase",
    "family",
    "kids",
    "game",
    "boop"
  ],
  "private": true,
  "license": "UNLICENSED",
  "author": "Matt O'Hara and Frankie",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattohara42/BoopTracker.git"
  },
  "homepage": "https://github.com/mattohara42/BoopTracker#readme",
  "bugs": {
    "url": "https://github.com/mattohara42/BoopTracker/issues"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-contacts": "~15.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.17.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
